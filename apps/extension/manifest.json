{
  "manifest_version": 3,
  "name": "Now Playing on sahilkhedkar.com",
  "version": "1.0.0",
  "description": "Syncs your YouTube Music playback in real-time to your portfolio website.",
  "permissions": ["storage"],
  "host_permissions": [
    "*://music.youtube.com/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "https://sahilkhedkar.com/*",
    "https://*.sahilkhedkar.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://music.youtube.com/*"],
      "js": ["bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["*://music.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
