# Now Playing Feature Environment Configuration
# Secret token used by your Chrome extension to authenticate updates
NOW_PLAYING_UPDATE_TOKEN=your_secure_random_token_here

# Redis Configuration (Optional)
# If omitted, an in-memory store will be used automatically.
# Option 1: Standard Redis URL (ioredis)
# REDIS_URL=redis://default:password@localhost:6379

# Option 2: Upstash Redis (REST API)
# UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token
